#!/home/vishwanath/Desktop/exp/.venv/bin/python
"""oanim — make living titles.
Usage:
  ./oanim new ep01                              # new video file in my_videos/
  ./oanim render my_videos/ep01.py --mode preview   # fast check
  ./oanim render my_videos/ep01.py --mode draft     # judge the look
  ./oanim render my_videos/ep01.py --mode final     # 1080p upload
Modes: preview (fast) / draft / final (1080p) / short (vertical).
Your videos live in ./my_videos. The tool lives in engine/ + scenes/.
"""
import os
import re
import sys
import argparse

ROOT = os.path.abspath(os.path.join(os.path.dirname(__file__)))
os.environ.setdefault("PIP_CACHE_DIR", os.path.join(ROOT, "tmp", "pip-cache"))
os.environ.setdefault("TMPDIR", os.path.join(ROOT, "tmp"))
sys.path.insert(0, ROOT)


def cmd_render(args):
    scene_path = os.path.abspath(args.scene)
    if not os.path.exists(scene_path):
        print("missing scene:", scene_path)
        return 2
    # import scene module to find Scene subclass
    import importlib.util
    spec = importlib.util.spec_from_file_location("user_scene", scene_path)
    mod = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(mod)
    from engine.api import Video
    found = [v for v in vars(mod).values()
             if isinstance(v, type) and issubclass(v, Video) and v is not Video]
    if not found:
        print("no video found in", scene_path, "(a class like: class Mine(Video): ...)")
        return 2
    cls = found[0]
    if args.out:
        out = os.path.abspath(args.out)
    else:
        # default: next to the scene file (my_videos/ep01.py -> my_videos/ep01.preview.mp4)
        base = os.path.splitext(os.path.basename(scene_path))[0]
        out = os.path.join(os.path.dirname(scene_path), f"{base}.{args.mode}.mp4")
    print(f"oanim: {cls.__name__} -> {out} [{args.mode}]")
    cls(save=out, mode=args.mode, encoder=args.encoder).run()
    return 0


def cmd_new(args):
    """Scaffold a new personal video in my_videos/ from scenes/template.py."""
    fname = re.sub(r"[^A-Za-z0-9_]+", "_", args.name).strip("_") or "my_video"
    if fname[0].isdigit():
        fname = "v_" + fname
    dest_dir = os.path.join(ROOT, "my_videos")
    os.makedirs(dest_dir, exist_ok=True)
    dest = os.path.join(dest_dir, fname + ".py")
    if os.path.exists(dest) and not args.force:
        print("exists (use --force to overwrite):", dest)
        return 1
    with open(os.path.join(ROOT, "scenes", "template.py")) as f:
        src = f.read()
    cls = "".join(w.capitalize() for w in fname.split("_")) or "MyVideo"
    src = src.replace('"""oanim starter — your video starts here. Change the words, then:\n'
                      '  ./oanim render scenes/template.py --mode preview\n'
                      '"""',
                      f'"""{fname} — my video. Change the words, then render it:\n'
                      f'  ./oanim render my_videos/{fname}.py --mode preview\n'
                      f'"""')
    src = src.replace('prog="oanim template"', f'prog="oanim {fname}"')
    src = src.replace("class MyVideo(Video):", f"class {cls}(Video):")
    src = src.replace('MyVideo(save=out, mode=a.mode).run()',
                      f'{cls}(save=out, mode=a.mode).run()')
    src = src.replace('ap.add_argument("--out", default="template.preview.mp4")',
                      f'ap.add_argument("--out", default="{fname}.preview.mp4")')
    with open(dest, "w") as f:
        f.write(src)
    print("NEW", dest)
    print(f"next: ./oanim render my_videos/{fname}.py --mode preview")
    return 0


def main():
    ap = argparse.ArgumentParser(prog="oanim")
    sub = ap.add_subparsers(dest="cmd", required=True)
    n = sub.add_parser("new", help="scaffold my_videos/<name>.py")
    n.add_argument("name", help="video name (e.g. ep01)")
    n.add_argument("--force", action="store_true",
                   help="overwrite if it exists")
    r = sub.add_parser("render", help="make a video file into an mp4")
    r.add_argument("scene", help="video file, e.g. my_videos/ep01.py")
    r.add_argument("--mode", default="preview", choices=["preview", "draft", "final", "short"])
    r.add_argument("--encoder", default="cpu", choices=["cpu", "vaapi"])
    r.add_argument("--out", default=None)
    a = ap.parse_args()
    if a.cmd == "render":
        return cmd_render(a)
    if a.cmd == "new":
        return cmd_new(a)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
